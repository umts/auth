= render layout: 'umts/brand/tabbed', locals: { heading: 'UMTS Auth' } do
  .card.mb-3
    .card-header Session
    .card-body
      %dl.d-flex.flex-column.gap-2.mb-0
        - session.each do |key, value|
          %div
            %dt= key
            %dd.mb-0= value
  - if session.key?(:entra_uid)
    = button_to 'Log out', logout_path, class: 'btn btn-primary', form_class: 'd-grid'
  - else
    = button_to 'Log in', entra_login_path, class: 'btn btn-primary', form_class: 'd-grid'
